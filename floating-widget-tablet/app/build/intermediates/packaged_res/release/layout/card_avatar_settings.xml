<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAvatarContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_neon"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header: Ícone User + Título + Subtítulo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_badge_icon_circle"
            android:padding="8dp"
            android:src="@drawable/ic_person_user"
            app:tint="@color/luminous_blue" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/card_avatar_title"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/card_avatar_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Body: Avatar Preview Circular + Ações -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Miniatura Circular do Avatar com Brilho Neon -->
        <FrameLayout
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:background="@drawable/bg_luminous_glow"
            android:padding="6dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivAvatarThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/avatar_profile"
                app:shapeAppearanceOverlay="@style/CircularImageViewShape" />
        </FrameLayout>

        <!-- Botão: Escolher fotografia -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChoosePhoto"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/bg_pill_primary"
            android:paddingHorizontal="22dp"
            android:text="@string/btn_choose_photo"
            android:textAllCaps="false"
            android:textColor="@color/text_dark_btn"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="23dp"
            app:icon="@drawable/ic_image_photo"
            app:iconPadding="8dp"
            app:iconSize="20dp"
            app:iconTint="@color/text_dark_btn" />

        <!-- Botão: Restaurar padrão -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestoreDefault"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_pill_secondary"
            android:paddingHorizontal="22dp"
            android:text="@string/btn_restore_default"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            app:backgroundTint="@null"
            app:cornerRadius="23dp"
            app:icon="@drawable/ic_restore_default"
            app:iconPadding="8dp"
            app:iconSize="18dp"
            app:iconTint="@color/text_secondary" />
    </LinearLayout>

</LinearLayout>
