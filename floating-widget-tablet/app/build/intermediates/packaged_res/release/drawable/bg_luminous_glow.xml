<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Camada 1: Halo exterior difuso de brilho ciano/azul -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#2600B4D8" />
        </shape>
    </item>
    <!-- Camada 2: Halo intermédio de transição néon -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="#4D00A3FF" />
        </shape>
    </item>
    <!-- Camada 3: Anel néon azul luminoso e nítido -->
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="oval">
            <stroke
                android:width="3.5dp"
                android:color="#00D2FF" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
