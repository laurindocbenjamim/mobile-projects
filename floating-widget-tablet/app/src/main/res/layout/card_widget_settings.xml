<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardWidgetSettingsContainer"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_card_neon"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="12dp">

    <!-- Header: Ícone Layers + Título + Subtítulo -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView
            android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/bg_badge_icon_circle"
            android:padding="7dp" android:src="@drawable/ic_layers_window"
            app:tint="@color/luminous_blue" />
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/card_widget_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp" android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/card_widget_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Body: Preview à esquerda + Controlos à direita -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical" android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/layoutWidgetSettingsPreviewContainer"
            android:layout_width="72dp" android:layout_height="72dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_luminous_glow"
            android:padding="6dp">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivWidgetSettingsPreview"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:src="@drawable/avatar_profile"
                app:shapeAppearanceOverlay="@style/CircularImageViewShape" />
            <ImageView
                android:id="@+id/ivWidgetPreviewModeBadge"
                android:layout_width="20dp" android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_toggle_button"
                android:padding="3dp" android:src="@drawable/ic_camera_switch"
                app:tint="@android:color/white" />
        </FrameLayout>

        <View
            android:layout_width="1dp" android:layout_height="80dp"
            android:layout_marginEnd="16dp"
            android:background="#142C4D" />

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">

            <!-- Linha 1: Modo Inicial -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView
                    android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_power_start" app:tint="@color/luminous_blue" />
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/row_initial_mode_title"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/row_initial_mode_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutSegmentedContainer"
                    android:layout_width="wrap_content" android:layout_height="40dp"
                    android:background="@drawable/bg_segmented_container"
                    android:gravity="center_vertical" android:orientation="horizontal"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/btnSegmentAvatar"
                        android:layout_width="wrap_content" android:layout_height="34dp"
                        android:background="@drawable/bg_segmented_selected"
                        android:clickable="true" android:focusable="true"
                        android:drawableStart="@drawable/ic_person_user"
                        android:drawablePadding="6dp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp" android:text="@string/segment_avatar"
                        android:textColor="@color/text_dark_btn"
                        android:textSize="12sp" android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnSegmentCamera"
                        android:layout_width="wrap_content" android:layout_height="34dp"
                        android:background="@android:color/transparent"
                        android:clickable="true" android:focusable="true"
                        android:drawableStart="@drawable/ic_camera_simple"
                        android:drawablePadding="6dp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp" android:text="@string/segment_camera"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Linha 2: Tamanho com Slider -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView
                    android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_resize_expand" app:tint="@color/luminous_blue" />
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/row_size_title"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/row_size_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="260dp" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <SeekBar
                        android:id="@+id/seekWidgetSize"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:max="2" android:progress="1"
                        android:progressBackgroundTint="#0F2B52"
                        android:progressTint="@color/luminous_blue"
                        android:thumb="@drawable/bg_slider_thumb" />
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:paddingHorizontal="8dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvSizeSmall"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="@string/size_small"
                            android:clickable="true" android:focusable="true"
                            android:textColor="@color/text_secondary" android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tvSizeMedium"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/size_medium"
                            android:clickable="true" android:focusable="true"
                            android:textColor="@color/text_primary" android:textSize="11sp" />
                        <TextView
                            android:id="@+id/tvSizeLarge"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:gravity="end"
                            android:clickable="true" android:focusable="true"
                            android:text="@string/size_large"
                            android:textColor="@color/text_secondary" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
